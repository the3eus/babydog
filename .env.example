# ---------------------------------------------------------------------------
# Baby Dog — variáveis de ambiente
#
# Copie este arquivo para ".env.local" e preencha o que for usar.
# O ".env.local" NÃO deve ir para o Git (já está no .gitignore).
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
# ---------------------------------------------------------------------------


# --- Destino do formulário de contato (opcional) ----------------------------
# O formulário já funciona sem nada aqui: ao enviar, abre o WhatsApp da
# recepção com a mensagem pronta. Preencha UMA das opções abaixo só se quiser
# que o lead também caia num CRM ou e-mail da clínica.

# Opção 1 — Webhook (n8n, Make, Zapier). Recebe um JSON com os dados do lead.
CONTACT_WEBHOOK_URL=

# Opção 2 — E-mail via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_EMAIL=
# Remetente verificado no Resend. Se não preencher, usa o domínio de teste.
CONTACT_FROM=


# --- Tracking ---------------------------------------------------------------
# Preencha conforme a clínica for criando as contas.
# Os eventos já estão disparando no código (lib/track.ts); só falta o ID.

NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=


# --- Avaliações reais do Google (Places API) --------------------------------
# Preencha as duas para exibir nota, total e trechos de avaliações REAIS do
# Google na seção de prova social — sempre atualizados sozinhos, sem editar
# código. Sem elas, a seção usa o texto genérico já confirmado pela clínica
# ("+200 avaliações no Google").
#
# 1. Crie um projeto e ative a "Places API" (tem cota gratuita mensal):
#    https://console.cloud.google.com/google/maps-apis
# 2. Gere uma chave de API e restrinja o uso dela (por API habilitada).
# 3. Ache o Place ID da clínica (busque pelo nome + endereço):
#    https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ID=
